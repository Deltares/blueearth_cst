# file based on github/gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
config/archieve/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
#*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
# Relocated to .tmp/pytest_cache (pyproject.toml). Kept as insurance: a
# config-less run still writes the root dir. Ignoring only keeps such a
# directory out of a COMMIT -- what keeps it out of the root is
# tests/test_cache_dir_hygiene.py, which fails on any cache directory here.
.pytest_cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
.static_storage/
.media/
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/
docs/generated/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# VScode
.vscode

# PyCharm
.idea

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# quarto documentation site (docs/_quarto.yml). Rendered output only. The cache
# is ignored by the TRACKED `docs/.gitignore`, which quarto writes and maintains
# itself (`/.quarto/`, `**/*.quarto_ipynb`) -- leave that file to the tool rather
# than hand-merging its entries up here.
#
# `docs/_freeze/` is deliberately NOT ignored: if the notebooks are ever
# published with results, those stored outputs are the tracked artifact that
# lets the site build without executing anything.
docs/_site/

# mypy
.mypy_cache/

# dask
dask-worker-space/

# snakemake
.snakemake/

# Examples. `test_case/*` rather than `test_case/`, so the seed config below can
# be re-included: git cannot un-ignore a file whose PARENT DIRECTORY is excluded,
# and the directory form would silently keep it untracked.
test_case/*
!test_case/snake_config_*.yml
# The basin inputs those configs name. Untracked until 2026-08-12, which broke
# both CI legs from 08-10: the seed config's `gauge_points` is a rule input, so
# a bare checkout could not resolve the wf1 DAG at all (MissingInputException,
# classified in tests/test_cli.py rather than predicted). Same two-step as the
# configs, one level deeper -- git will not descend into an excluded DIRECTORY,
# so `!test_case/test_data/*.csv` on its own matches nothing.
!test_case/test_data/
test_case/test_data/*
!test_case/test_data/*.csv
.Rproj.user

# R-related files
/config/reticulate_config.R
.Rhistory
.RData

# Images
*.png

# Rendered workflow DAGs (scripts/run_snake_test.cmd writes .dot + .png here)

# Tests
tests/test_project

# AI tooling local state (per-user; never committed). No trailing slash: in a
# worktree these are SYMLINKS to the primary's copies (`worktree_link:` in
# .git-workflow.yml), and git sees a symlink as a file, so a `dir/` pattern
# stops matching and the link shows up as untracked -- one `git add -A` from
# committing a machine-specific absolute path.
.claude
.agents
.codex

# Baked toolbox commit, written by the Dockerfile from ARG TOOLBOX_COMMIT.
# The image carries no .git, so this file is how a deployed run learns its own
# revision. It must be ABSENT in a normal checkout: provenance.toolbox_identity()
# resolves git first and falls back to this file, so a committed copy would let
# a stale sha outrank the live one.
.toolbox-commit

# Local-only config variants (per-user; never committed)
*_local.yml
*_gabon.yml

# v0 → v1 catalog migration safety copies (left during M2b)
*.v0bak

# Scratch: ONE place for disposable machine-local output, at the repo root.
# Anything a run, a probe, or a pytest --basetemp writes goes here and is never
# committed. Consolidated 2026-08-02 from dev/tmp/ + an unignored .tmp/ that
# held 1172 untracked files (60 MB) one `git add -A` from being staged.
# The tool caches were redirected here on 2026-08-11 (pyproject.toml `cache_dir`
# / `cache-dir`), so .tmp/ now covers them and the root carries neither dir.
.tmp/

# dev/ is the process record: prose, tables, and small tabular evidence only.
# netCDF probe/QA states belong outside the repo -- the two that reached
# dev/milestones/p32a/qa/ were 68 MB, the largest blobs in this history. Record the
# finding in Markdown and the artifact's SHA256, not the artifact.
dev/**/*.nc
