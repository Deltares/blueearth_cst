# Relocated legacy evidence retains the exact original Git bytes on every platform.
dev/records/milestones/post-r12/output-schema/** -text -whitespace

# The vendored hydromt `deltares_data` catalog records the upstream body's
# sha256 in its header, and hydromt's own registry hashes that file byte for
# byte. Under `*.yml text` the bytes would be LF in the repository and CRLF in
# a Windows checkout, so the recorded hash would reproduce on one leg only.
config/catalogs/deltares_data_pdrive.yml -text
dev/records/milestones/r12/stress-test-design-and-surface-axes-2026-08-15.md -text -whitespace
