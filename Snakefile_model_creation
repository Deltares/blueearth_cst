import sys
from pathlib import Path

# Shared helpers live in blueearth_cst/; make them importable regardless of the working
# directory by prepending this Snakefile's own directory to sys.path.
# See dev/r03/model-builder-design.md §3.
sys.path.insert(0, str(Path(workflow.basedir)))
from blueearth_cst.shared.snake_utils import DEFAULT_BASIN_INDEX, DEFAULT_HYDROGRAPHY, DEFAULT_JULIA_THREADS, climate_store_spec, get_config, julia_prefix, patch_psutil_windows_benchmark, rule_banner, target_banner, validate_historical_window, warn_if_project_dir_in_repo
# The canonical climate figure set (rules 1.13 and 1.15 both draw it). Imported
# for figure_names() ONLY, so every figure is declared from the same list the
# plotter writes from and the two cannot drift.
from blueearth_cst.climate_analysis.climate_figures import figure_names

# Windows: make Snakemake's benchmark memory/IO/CPU metrics work (else all NA).
patch_psutil_windows_benchmark()

# read path of the config file (Snakemake records it from --configfile) so
# downstream R scripts can be handed the same path. Forwarding config_path is
# a repo convention — keep it even though the Snakefile itself uses `config`.
config_path = workflow.configfiles[0]

# Portable tee wrapper for the shell rules below: keeps live console output AND
# preserves the child's exit code (a bare `| tee` masks failures on cmd.exe --
# no pipefail there). See blueearth_cst/shared/run_logged.py / blueearth_cst.shared.snake_utils.run_and_tee.
run_logged = str(Path(workflow.basedir) / "blueearth_cst" / "shared" / "run_logged.py")

# R01 schema — three top-level sections. Read each into a local dict.
project_cfg = config["project"]
shared_cfg = config["shared"]
my_cfg = config["workflows"]["model_creation"]

# Project — paths and external resources
project_dir = get_config(project_cfg, "project_dir", optional=False)
# O-22: make the two-tier project_dir rule mechanical rather than
# documentary. Warns, never raises; test_case/ is the one exemption.
warn_if_project_dir_in_repo(project_dir, workflow.basedir)
static_dir = get_config(project_cfg, "static_dir", optional=False)
DATA_SOURCES = get_config(project_cfg, "data_sources", optional=False)

# Shared — multi-workflow scientific knobs
basin_cfg = shared_cfg["basin"]
model_region = get_config(basin_cfg, "region", optional=False)
model_resolution = get_config(basin_cfg, "resolution", 0.00833333)
# Catalog ENTRY NAMES for the model-free basin delineation the shared climate
# store uses (R07 B1 / ext1-01). Both OPTIONAL: the defaults equal the shipped
# build template's setup_basemaps values, so a config that declares neither is
# unaffected and rule 3.00b's guard digest stays byte-identical. Rule 1.02
# cross-checks them against the template and fails loud on a disagreement.
basin_hydrography = get_config(basin_cfg, "hydrography", DEFAULT_HYDROGRAPHY)
basin_index = get_config(basin_cfg, "basin_index", DEFAULT_BASIN_INDEX)
historical_window = get_config(shared_cfg, "historical_window", optional=False)
# ONE minimum window for the whole toolbox — snake_utils.MIN_HISTORICAL_YEARS
# (16), set by weathergenr's wavelet minimum and enforced identically here and
# at extraction. WF1 rejects it too, deliberately: a record too short for a
# stress test is a misconfigured project, and letting WF1 build a model on it
# only moves the failure to the workflow least able to explain it
# (dev/followups.md R7-6, R3). Parse time, before any rule executes — same
# stance as the eobs rejection below. Whether the staged source actually COVERS
# the requested window is a different question, checked at rule 1.10.
validate_historical_window(historical_window)
clim_source = get_config(shared_cfg, "clim_historical", optional=False)
# Wflow.jl thread count for rule 1.09. OPTIONAL — the default is P3-3's frozen
# baseline value, so an existing config is unaffected. Config-driven rather than
# inline so a deployment can tune it to its basin (a production basin has the
# cell-parallelism the 384-cell test fixture lacks) without a Snakefile edit.
# NOT Snakemake's `threads:`, which caps at --cores: see DEFAULT_JULIA_THREADS.
julia_threads = get_config(shared_cfg, "julia_threads", DEFAULT_JULIA_THREADS)
# Carries the juliaup version pin too; both are validated at parse time, before
# any rule can put them in a shell body.
wflow_julia = julia_prefix(julia_threads)

# P3-2a bounded support (design ext2-3): the wf1 raw-climate path (rule 1.10 +
# the model-parity plot re-source) supports era5, chirps and chirps_global
# only. eobs fails here at DAG-parse time — before any rule executes — so the
# rejection is early and loud on every run and dry-run.
if clim_source == "eobs":
    raise ValueError(
        "clim_historical: eobs is not supported by the P3-2a wf1 raw-climate "
        "path; supported sources: era5, chirps, chirps_global"
    )

# Workflow-owned
wflow_outvars = get_config(my_cfg, "wflow_outvars", ['river discharge', 'actual evapotranspiration'])
model_build_config = get_config(my_cfg, "model_build_config", f"{static_dir}/templates/wflow_build_model.yml")
waterbodies_config = get_config(my_cfg, "waterbodies_config", f"{static_dir}/templates/wflow_update_waterbodies.yml")
output_locations = get_config(my_cfg, "output_locations", None)
observations_timeseries = get_config(my_cfg, "observations_timeseries", None)

basin_dir = f"{project_dir}/hydrology_model"

# The canonical climate figure set, one directory per dataset (rule 1.13 draws
# the forcing, 1.15 the source). variable x kind is a fixed cross-product, so
# unlike rule 1.11's per-station figures these are fully knowable at parse time
# and ALL of them are declared — see climate_figures' module docstring.
FORCING_PLOTS_DIR = f"{basin_dir}/forcing/plots"
_forcing_climate_pngs = [f"{FORCING_PLOTS_DIR}/{name}" for name in figure_names("forcing")]

# --- The shared historical-climate store (R07 B1) -----------------------------
# ONE producer contract, built here and identically in
# Snakefile_climate_experiment, and splatted into rule 1.10 / rule 3.02 below.
# Everything content- or execution-determining (script, the single catalog
# input, outputs, params) comes from this object; only message/log/benchmark are
# workflow-local. tests/test_climate_store_contract.py parses both workflows and
# fails on ANY other difference.
CLIMATE_STORE = climate_store_spec(
    project_dir=project_dir,
    model_region=model_region,
    clim_source=clim_source,
    historical_window=historical_window,
    data_sources=DATA_SOURCES,
    hydrography=basin_hydrography,
    basin_index=basin_index,
)
store_dir = CLIMATE_STORE.store_dir

# Rule numbering (comment headers + log/benchmark filenames) uses `W.NN` =
# workflow.step in DEFINITION order — a reading and reference aid ("Rule 1.3" =
# create_model), NOT guaranteed execution order. Snakemake resolves execution
# from the DAG: e.g. 1.10-1.12 are parallel plot leaves, not a sequence. All
# three workflows share project_dir/logs, so the leading digit keeps them
# disambiguated and globally sortable. Convention: dev/conventions/naming.md.

# --- log layout ---------------------------------------------------------------
# EVERY WF1 rule that logs writes a PART under logs/_parts/, and rule 1.16 merges
# the parts into ONE logs/wf1_model_creation.log, then deletes them. So the only
# WF1 file left in logs/ after a full run is that merged log — matching WF2 (2.07)
# and WF3 (3.13), and the deal benchmarks/wf1_benchmarks.md already had.
#
# LOG_RULES is the merge order: rule LABELS, not part paths. merge_logs lists each
# label's part dir to find its members, so a fan-out width lives only in the rule
# that owns it (WF1 has no fan-out today; WF3 does). Naming the labels rather than
# globbing `_parts/` keeps an orphan dir from a renamed rule out of the file.
# Order is by RULE NUMBER, matching the rule map and benchmarks/wf1_benchmarks.md,
# not execution order (1.11–1.13 are parallel leaves). 1.01 copy_config declares
# no `log:` and so has no section.
WORKFLOW_LOG_NAME = "wf1_model_creation.log"
LOG_PARTS_DIR = f"{project_dir}/logs/_parts"
LOG_RULES = [
    "1.02_prepare_build_config",
    "1.03_create_model",
    "1.04_add_reservoirs_lakes_glaciers",
    "1.05_add_gauges_and_outputs",
    "1.06_write_outlet_index",
    "1.07_setup_runtime",
    "1.08_add_forcing",
    "1.09_run_wflow",
    "1.10_extract_climate_grid",
    "1.11_plot_results",
    "1.12_plot_map",
    "1.13_plot_forcing",
    "1.15_plot_climate_source",
]

# WF1_TERMINALS — the artifacts with no WF1 consumer: every producing rule is
# upstream of them and none of them feeds another rule. That is exactly the
# input set the two gather rules (1.14 benchmarks, 1.16 logs) need, which is
# what schedules each one LAST; both restated these seven literals before, so a
# new terminal had to be added in three places or a gather would run early and
# merge an incomplete set of parts.
#
# NOT terminals, and so not in this list: the config snapshot (1.01 runs
# independently of the build and needs no gather waiting on it) and the two
# gather outputs themselves.
WF1_TERMINALS = [
    f"{basin_dir}/evaluation/plots/hydro_wflow_1.png",
    f"{basin_dir}/plots/basin_area.png",
    # One representative of each canonical climate set: the rules produce their
    # nine figures as a unit, so naming every one here would add no edge.
    f"{FORCING_PLOTS_DIR}/forcing_precip_map.png",
    # R07 B4: the source-grid climate figures are rule-`all` members by
    # design — they are a product of the workflow, not an incidental
    # by-product, and their subgraph needs no built model.
    f"{store_dir}/plots/source_precip_map.png",
    f"{basin_dir}/staticgeoms/outlet_index.csv",
]

# 1.00  all — target aggregator: full historical build + performance plots
#
# Hoisted into a list so `message:` can print one target per line without
# restating them. Snakemake flattens a list argument, so `input: WF1_TARGETS`
# declares exactly the same ten files the literals did — the terminals, plus
# the config snapshot and the two gathered artifacts.
WF1_TARGETS = [
    *WF1_TERMINALS,
    f"{project_dir}/config/runs/snake_config_model_creation.yml",
    f"{project_dir}/logs/{WORKFLOW_LOG_NAME}",
    f"{project_dir}/benchmarks/wf1_benchmarks.md",
]

rule all:
    message: target_banner("1.00", "all", WF1_TARGETS, project_dir)
    input:
        WF1_TARGETS,

# 1.01  copy_config — copy build/snake/waterbodies configs into project_dir/config
rule copy_config:
    message: rule_banner("1.01", "copy_config")
    input:
        config_build = model_build_config,
        config_snake = config_path,
        config_waterbodies = waterbodies_config,
    params:
        data_catalogs = DATA_SOURCES,
        workflow_name = "model_creation",
        config_dir = f"{project_dir}/config",
    output:
        config_snake_out = f"{project_dir}/config/runs/snake_config_model_creation.yml",
    script:
        "blueearth_cst/model/copy_config_files.py"

# 1.02  prepare_build_config — merge snake-config values (model_resolution) into
# the build config. hydromt 1.3 dropped `--opt`, so we generate a runtime config.
rule prepare_build_config:
    message: rule_banner("1.02", "prepare_build_config")
    input:
        template = model_build_config,
    output:
        merged = f"{project_dir}/config/generated/wflow_build_model_run.yml",
    params:
        model_resolution = model_resolution,
        model_region = model_region,
        # R07 B1: agreement between the build template's setup_basemaps datasets
        # and shared.basin is ENFORCED here (RuntimeError naming both files and
        # both values), not shared-sourced — the template stays the
        # hydromt-conventional home of build datasets and is never overwritten.
        hydrography = basin_hydrography,
        basin_index = basin_index,
        snake_config = config_path,
    log:
        f"{LOG_PARTS_DIR}/1.02_prepare_build_config.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.02_prepare_build_config.tsv",
    script:
        "blueearth_cst/model/prepare_build_config.py"

# 1.03  create_model — build the Wflow-SBM model (hydromt build wflow_sbm)
rule create_model:
    message: rule_banner("1.03", "create_model")
    input:
        hydromt_ini = f"{project_dir}/config/generated/wflow_build_model_run.yml",
    output:
        basin_nc = f"{basin_dir}/staticmaps.nc",
        # Completion sentinel (R7-1). `wflow_sbm.toml` is CREATED here and then
        # updated IN PLACE by rules 1.04-1.08, but only this rule declares it,
        # so a re-fire of create_model alone used to leave the toml stripped of
        # every section the later rules add -- and the next wflow run died on
        # the missing key. The obvious fix (drop the ancient() on staticmaps in
        # those rules) is WRONG: they mutate staticmaps themselves via
        # mod.write()/mod.close(), so a plain input would make each one
        # re-trigger on its own execution forever. This sentinel is written by
        # nothing else, so it re-fires rule 1.04 without any self-trigger, and
        # the chain cascades from there (1.04 -> .txt -> 1.05 ->
        # outlets.geojson -> 1.07 -> forcing yml -> 1.08).
        built = touch(f"{basin_dir}/.model_built"),
    log:
        f"{LOG_PARTS_DIR}/1.03_create_model.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.03_create_model.tsv",
    shell:
        """python -u "{run_logged}" "{log}" -- hydromt build wflow_sbm "{basin_dir}" -i "{input.hydromt_ini}" -d "{DATA_SOURCES}" --fo -vv"""

# 1.04  add_reservoirs_lakes_glaciers — add waterbodies to the built model
# (temporary hydromt fix; can fold back into create_model when hydromt is updated)
rule add_reservoirs_lakes_glaciers:
    message: rule_banner("1.04", "add_reservoirs_lakes_glaciers")
    input:
        # ancient(): this rule COMMITS writes back into staticmaps.nc, so a
        # plain input would re-trigger it on its own output. Ordering and
        # rebuild-detection come from the sentinel below instead (R7-1).
        basin_nc = ancient(f"{basin_dir}/staticmaps.nc"),
        model_built = f"{basin_dir}/.model_built"
    output:
        text_out = f"{basin_dir}/staticgeoms/reservoirs_lakes_glaciers.txt"
    params:
        data_catalog = DATA_SOURCES,
        config = waterbodies_config,
    log:
        f"{LOG_PARTS_DIR}/1.04_add_reservoirs_lakes_glaciers.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.04_add_reservoirs_lakes_glaciers.tsv",
    script:
        "blueearth_cst/model/setup_reservoirs_lakes_glaciers.py"

# 1.05  add_gauges_and_outputs — add gauges + output variables to the model
rule add_gauges_and_outputs:
    message: rule_banner("1.05", "add_gauges_and_outputs")
    input:
        basin_nc = ancient(f"{basin_dir}/staticmaps.nc"),
        text = f"{basin_dir}/staticgeoms/reservoirs_lakes_glaciers.txt"
    output:
        gauges_path = f"{basin_dir}/staticgeoms/outlets.geojson"
    params:
        output_locs = output_locations,
        outputs = wflow_outvars,
        data_catalog = DATA_SOURCES
    log:
        f"{LOG_PARTS_DIR}/1.05_add_gauges_and_outputs.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.05_add_gauges_and_outputs.tsv",
    script:
        "blueearth_cst/model/setup_gauges_and_outputs.py"

# 1.06  write_outlet_index — write the outlet position -> subcatchment-ID mapping
rule write_outlet_index:
    message: rule_banner("1.06", "write_outlet_index")
    input:
        outlets_path = f"{basin_dir}/staticgeoms/outlets.geojson"
    output:
        outlet_index_path = f"{basin_dir}/staticgeoms/outlet_index.csv"
    log:
        f"{LOG_PARTS_DIR}/1.06_write_outlet_index.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.06_write_outlet_index.tsv",
    script:
        "blueearth_cst/model/write_outlet_index.py"

# 1.07  setup_runtime — prepare the forcing time horizon / runtime window
rule setup_runtime:
    message: rule_banner("1.07", "setup_runtime")
    input:
        gauges_path = f"{basin_dir}/staticgeoms/outlets.geojson"
    output:
        forcing_yml = f"{project_dir}/config/generated/wflow_build_forcing_historical.yml"
    params:
        starttime = get_config(shared_cfg["historical_window"], "starttime", optional=False),
        endtime = get_config(shared_cfg["historical_window"], "endtime", optional=False),
        clim_source = get_config(shared_cfg, "clim_historical", optional=False),
        basin_dir = basin_dir,
    log:
        f"{LOG_PARTS_DIR}/1.07_setup_runtime.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.07_setup_runtime.tsv",
    script: "blueearth_cst/shared/setup_time_horizon.py"

# 1.08  add_forcing — add historical forcing to the model (hydromt update wflow_sbm)
rule add_forcing:
    message: rule_banner("1.08", "add_forcing")
    input:
        forcing_ini = f"{project_dir}/config/generated/wflow_build_forcing_historical.yml"
    output:
        forcing_path = f"{basin_dir}/forcing/inmaps_historical.nc"
    log:
        f"{LOG_PARTS_DIR}/1.08_add_forcing.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.08_add_forcing.tsv",
    shell:
        """python -u "{run_logged}" "{log}" -- hydromt update wflow_sbm "{basin_dir}" -i "{input.forcing_ini}" -d "{DATA_SOURCES}" -vv"""

# 1.09  run_wflow — run the Wflow.jl model on historical forcing
rule run_wflow:
    message: rule_banner("1.09", "run_wflow")
    input:
        forcing_path = f"{basin_dir}/forcing/inmaps_historical.nc"
    output:
        csv_path = f"{basin_dir}/run_default/output.csv"
    params:
        toml_path = f"{basin_dir}/wflow_sbm.toml"
    log:
        f"{LOG_PARTS_DIR}/1.09_run_wflow.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.09_run_wflow.tsv",
    shell:
        """python -u "{run_logged}" "{log}" -- {wflow_julia} -e "using Wflow; Wflow.run()" "{params.toml_path}" """

# 1.10  extract_climate_grid — the SHARED historical-climate store producer
# (R07 B1). This declaration and rule 3.02 in Snakefile_climate_experiment are
# the same rule: identical name, script, single catalog input, outputs and
# params, all splatted from CLIMATE_STORE. Only message/log/benchmark are
# workflow-local. wf1's old `climate_historical/wf1_raw/` store and its
# ancient(staticmaps.nc) edge are retired — the extent is now a pure function of
# shared.basin + the catalog, so this rule needs no built model, and a region
# change re-extracts via Snakemake's params rerun-trigger.
#
# DO NOT add a workflow-local input or param here: an asymmetric input set
# re-creates the wf1<->wf3 re-extraction oscillation (design P2(b), ext1-02) and
# is forbidden. The catalog input is deliberately PLAIN, not ancient(): it is
# the store's freshness boundary (ext2-01).
rule extract_climate_grid:
    message: rule_banner("1.10", "extract_climate_grid")
    input:
        **CLIMATE_STORE.inputs,
    params:
        **CLIMATE_STORE.params,
    output:
        **CLIMATE_STORE.outputs,
    log:
        f"{LOG_PARTS_DIR}/1.10_extract_climate_grid.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.10_extract_climate_grid.tsv",
    script:
        CLIMATE_STORE.script

# 1.11  plot_results — analyse + plot the wflow run (parallel leaf with 1.12/1.13)
# The climate plots read the shared store's extraction (rule 1.10) at model
# parity — not the inmaps forcing (P3-2a re-source; was ADR 0002). On chirps/
# chirps_global the extraction's orography sidecar is a declared input with a
# real producer edge (ext2-1); producer and consumer resolve that branch from
# the same clim_historical key via CLIMATE_STORE, so they cannot disagree.
_wf1_plot_clim_inputs = {"climate_nc": CLIMATE_STORE.outputs["climate_nc"]}
if clim_source in ("chirps", "chirps_global"):
    _wf1_plot_clim_inputs["oro_nc"] = CLIMATE_STORE.outputs["oro_nc"]

# O-24, basin-average half. The ONE plot_results family that is a pure function
# of config, so it is declared rather than left undeclared.
#
# Two exclusions, both load-bearing — do not "simplify" either away:
#  - "river discharge" never gets a basavg column at all. Rule 1.05 covers it
#    via setup_outlets/setup_gauges and filters it out of the basin-average
#    setup (setup_gauges_and_outputs.py, `extras`).
#  - "precipitation" DOES get a column, and plot_results drops it before
#    plotting (plot_results.py, `drop_vars("precipitation_basavg")`), so the
#    figure is never written.
# The filename is the CSV column name verbatim (func_plot_signature.plot_basavg
# writes f"{dvar}.png"), which is why it carries the config's spelling, spaces
# included.
_WFLOW_OUTVARS_WITHOUT_BASAVG_PLOT = ("river discharge", "precipitation")
_basavg_pngs = [
    f"{basin_dir}/evaluation/plots/{var}_basavg.png"
    for var in wflow_outvars
    if var not in _WFLOW_OUTVARS_WITHOUT_BASAVG_PLOT
]

rule plot_results:
   message: rule_banner("1.11", "plot_results")
   input:
       csv_path = f"{basin_dir}/run_default/output.csv",
       **_wf1_plot_clim_inputs,
       script = "blueearth_cst/model/plot_results.py"
   # R07 B10 + O-24. The artifacts move into the engine subtree, split by KIND
   # (P1): figures under evaluation/plots/, the metrics table one level up in
   # evaluation/, because plots/ holds figures only.
   #
   # O-24, restated 2026-08-01 after checking what is actually derivable.
   #
   # DECLARED: the config-invariant subset below, plus `_basavg_pngs` — one PNG
   # per basin-average entry in wflow_outvars, a pure function of config.
   #
   # STILL UNDECLARED, and NOT for want of effort: hydro_{station}.png,
   # clim_{station}_{month,year}.png and signatures_{station}.png. R7-5 assumed
   # these could be derived at parse time "from wflow_outvars /
   # output_locations". They cannot. Their count is the number of model OUTLETS
   # and SUBCATCHMENTS, which is a product of the model build (rule 1.03, read
   # back through Q_outlets / the subcatchment map) — unknown until rule 1.03
   # has run, and output_locations contributes only the extra gauge stations on
   # top. signatures_* is narrower still: it also requires observations AND a
   # run longer than a year (plot_results.py `do_signatures`), so it is
   # data-conditional, not merely config-conditional.
   #
   # Closing those needs a checkpoint or a directory() output, i.e. a real
   # rule-shape change, not the enumeration R7-5 imagined. `--delete-all-output`
   # completeness therefore still holds only for configs without extra gauges.
   #
   # KNOWN CONSEQUENCE of declaring the two clim_wflow_1_* figures: they are
   # written only when the store's extraction is present AND covers >= 365
   # days (plot_results.py's climate branch). A config with a sub-year
   # historical_window now fails here with MissingOutputException instead of
   # logging a skip. Every shipped config spans years, so no shipped config is
   # affected; recorded because it is a NEW failure mode, not just a
   # declaration.
   output:
       output_png = f"{basin_dir}/evaluation/plots/hydro_wflow_1.png",
       clim_month_png = f"{basin_dir}/evaluation/plots/clim_wflow_1_month.png",
       clim_year_png = f"{basin_dir}/evaluation/plots/clim_wflow_1_year.png",
       metrics_csv = f"{basin_dir}/evaluation/performance_metrics.csv",
       basavg_pngs = _basavg_pngs,
   params:
       project_dir = f"{project_dir}",
       observations_file = observations_timeseries,
       gauges_output_path = output_locations,
       data_sources = DATA_SOURCES,
       clim_source = clim_source,
   log:
       f"{LOG_PARTS_DIR}/1.11_plot_results.log",
   benchmark:
       f"{project_dir}/benchmarks/_parts/1.11_plot_results.tsv",
   script: "blueearth_cst/model/plot_results.py"

# 1.12  plot_map — plot basin, rivers, gauges and DEM on a map (parallel leaf)
rule plot_map:
    message: rule_banner("1.12", "plot_map")
    input:
        gauges_path = f"{basin_dir}/staticgeoms/outlets.geojson"
    # R07 B10: basin_area.png depicts the MODEL, not its evaluation (P1), so it
    # sits at the model root's plots/.
    output:
        output_map_png = f"{basin_dir}/plots/basin_area.png",
    params:
        project_dir = f"{project_dir}",
        output_locations = output_locations,
    log:
        f"{LOG_PARTS_DIR}/1.12_plot_map.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.12_plot_map.tsv",
    script: "blueearth_cst/shared/plot_map.py"

# 1.13  plot_forcing — the canonical climate set for the wflow forcing
# (parallel leaf). Same figures as rule 1.15 draws for the source grid, so the
# two directories answer "what did the downscaling change?" side by side.
rule plot_forcing:
    message: rule_banner("1.13", "plot_forcing")
    input:
        forcing_path = f"{basin_dir}/forcing/inmaps_historical.nc",
    # R07 B10 + O-24: the forcing/model-input QA figures sit beside the forcing
    # they describe, and ALL of them are declared — variable x kind is a fixed
    # cross-product, so the list comes from climate_figures.figure_names()
    # rather than being restated here.
    output:
        _forcing_climate_pngs,
    params:
        project_dir = f"{project_dir}",
        gauges_path = f"{basin_dir}/staticgeoms/outlets.geojson"
    log:
        f"{LOG_PARTS_DIR}/1.13_plot_forcing.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.13_plot_forcing.tsv",
    script: "blueearth_cst/model/plot_map_forcing.py"

# --- benchmark gather ---------------------------------------------------------
# Per-rule benchmarks land under benchmarks/_parts/. This runs once, after the
# terminal outputs (so all WF1 rules ran), and merges the WF1 parts into one
# benchmarks/wf1_benchmarks.tsv (rule column + TOTAL row), fresh each run.
rule gather_benchmarks:
    message: rule_banner("1.14", "gather_benchmarks")
    input:
        WF1_TERMINALS,
    output:
        f"{project_dir}/benchmarks/wf1_benchmarks.md",
    params:
        parts_dir = f"{project_dir}/benchmarks/_parts",
        workflow_num = 1,
    script: "blueearth_cst/shared/merge_benchmarks.py"

# 1.15  plot_climate_source — source-grid climate figures from the shared store
# (R07 B4 / P4). Declared HERE ONLY: unlike rule 1.10 this is a single
# declaration, so none of B1's two-DAG symmetry machinery applies.
#
# The whole subgraph of these figures is rule 1.10 (whose sole input is the
# tracked data catalog) plus this rule, so they build with NEITHER
# hydrology_model/ NOR config/templates/wflow_build_model.yml on disk — the P4
# assertion, pinned by tests/test_plot_climate_source.py.
#
# The data catalog rides in `params`, not `input`: the era5 branch resolves
# `era5_orography` through it, but the store's freshness boundary is rule 1.10's
# catalog edge (ext2-01) and duplicating it here would re-plot on every catalog
# touch without the extraction having changed.
_source_plot_inputs = {"climate_nc": CLIMATE_STORE.outputs["climate_nc"]}
if clim_source in ("chirps", "chirps_global"):
    # Same branch split as rule 1.11: on chirps the store carries an orography
    # sidecar and it is a declared input; on era5 there is none and the
    # orography comes from the catalog instead.
    _source_plot_inputs["oro_nc"] = CLIMATE_STORE.outputs["oro_nc"]

rule plot_climate_source:
    message: rule_banner("1.15", "plot_climate_source")
    input:
        **_source_plot_inputs,
    output:
        [f"{store_dir}/plots/{name}" for name in figure_names("source")],
    params:
        plot_dir = f"{store_dir}/plots",
        data_sources = DATA_SOURCES,
        clim_source = clim_source,
    log:
        f"{LOG_PARTS_DIR}/1.15_plot_climate_source.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.15_plot_climate_source.tsv",
    script: "blueearth_cst/climate_analysis/plot_climate_source.py"

# 1.16  gather_logs — merge every WF1 log part into ONE workflow log.
#
# Same rule as WF2's 2.07 and WF3's 3.13, against the same script; only the label
# list, the parts dir and the output name differ. `input:` is WF1_TERMINALS, the
# same set gather_benchmarks takes, which is what schedules it LAST: every
# logging rule is upstream of it. The parts stay in `params:` — they are
# `log:` files, and Snakemake does not track those in the DAG, so naming them as
# `input:` would demand them as buildable targets.
#
# The merge DELETES the parts it consumed and prunes the emptied dirs, so a clean
# full run leaves no logs/_parts/ at all. After a PARTIAL re-run only the re-run
# rules have parts, so the rewritten log marks the rest "no part from this run" —
# the same trade `merge_benchmarks` makes (dev/followups.md R7-9).
rule gather_logs:
    message: rule_banner("1.16", "gather_logs")
    input:
        WF1_TERMINALS,
    output:
        f"{project_dir}/logs/{WORKFLOW_LOG_NAME}",
    params:
        rules = LOG_RULES,
        parts_dir = LOG_PARTS_DIR,
    script: "blueearth_cst/shared/merge_logs.py"
