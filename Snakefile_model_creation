# 1.07  setup_runtime — prepare the forcing time horizon / runtime window
rule setup_runtime:
    message: rule_banner("1.07", "setup_runtime")
    input:
        gauges_path = f"{basin_dir}/staticgeoms/outlets.geojson",
        outputs_configured = f"{basin_dir}/.outputs_configured",
    output:
        # Generated build YAML is provenance OF THE MODEL IT BUILT, so it lives
        # in the model's own config/ rather than a project-level generated/
        # (design v10). `config/generated/wflow_build_model_run.yml` had a row
        # in the migration map beside this one; nothing writes it any more, and
        # R9 P1 retired that row (phase-1 report G2).
        forcing_yml = f"{basin_dir}/config/build_historical_forcing.yml"
    params:
        starttime = get_config(shared_cfg["historical_window"], "starttime", optional=False),
        endtime = get_config(shared_cfg["historical_window"], "endtime", optional=False),
        clim_source = get_config(shared_cfg, "clim_historical", optional=False),
        basin_dir = basin_dir,
    log:
        f"{LOG_PARTS_DIR}/1.07_setup_runtime.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.07_setup_runtime.tsv",
    script: "blueearth_cst/shared/setup_time_horizon.py"

# 1.08  add_forcing — add historical forcing to the model (hydromt update wflow_sbm)
rule add_forcing:
    message: rule_banner("1.08", "add_forcing")
    input:
        forcing_ini = f"{basin_dir}/config/build_historical_forcing.yml"
    output:
        forcing_path = f"{basin_dir}/forcing/inmaps_historical.nc",
        # TERMINAL BUILD SENTINEL (ADR 0004). `hydromt update wflow_sbm` calls
        # mod.write(), which rewrites the WHOLE model root -- measured on the R9
        # gate run, where staticmaps.nc, wflow_sbm.toml, hydromt.log and every
        # staticgeoms/ layer all carry this rule's timestamps. So THIS rule, not
        # 1.03, is the last writer of the model, and it is the only correct
        # ordering anchor for a reader.
        #
        # `.outputs_configured` (rule 1.05) was the anchor until now and is NOT
        # sufficient: it precedes this rule's write of staticmaps.nc by 17 s on
        # that same run. Rule 1.12 read staticmaps.nc and finished 9 s before
        # this rule rewrote it -- a timing accident, not a DAG edge, and one
        # that closes as the basin grows. The failure is silent:
        # HDF5_USE_FILE_LOCKING="FALSE" in the pixi env means a concurrent read
        # aborts below Python with no traceback (R9 P2 F5).
        #
        # RESIDUAL RISK, stated because no test can catch it: this sentinel is
        # correct only while this rule is the last writer of the model root. A
        # new rule that mutates the model after 1.08 must move the sentinel to
        # itself. `tests/test_model_root_ordering.py` checks that readers
        # declare it, not that it is attached to the right rule.
        model_final = touch(f"{basin_dir}/.model_final"),
    log:
        f"{LOG_PARTS_DIR}/1.08_add_forcing.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.08_add_forcing.tsv",
    shell:
        """python -u "{run_logged}" "{log}" -- hydromt update wflow_sbm "{basin_dir}" -i "{input.forcing_ini}" -d "{DATA_SOURCES}" -vv"""

# 1.09  run_wflow — run the Wflow.jl model on historical forcing
rule run_wflow:
    message: rule_banner("1.09", "run_wflow")
    input:
        forcing_path = f"{basin_dir}/forcing/inmaps_historical.nc",
        # ADR 0004. Already ordered after 1.08 through forcing_path; declared
        # anyway so the invariant is LOCAL rather than transitive -- a reader is
        # correct because of what it declares, not because of a chain someone
        # has to re-derive.
        model_final = ancient(f"{basin_dir}/.model_final"),
    output:
        csv_path = f"{basin_dir}/run_default/output.csv"
    params:
        toml_path = f"{basin_dir}/wflow_sbm.toml"
    log:
        f"{LOG_PARTS_DIR}/1.09_run_wflow.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.09_run_wflow.tsv",
    shell:
        """python -u "{run_logged}" "{log}" -- {wflow_julia} -e "using Wflow; Wflow.run()" "{params.toml_path}" """

# 1.10  extract_climate_grid — the SHARED historical-climate store producer
# (R07 B1). This declaration and rule 3.02 in Snakefile_climate_experiment are
# the same rule: identical name, script, single catalog input, outputs and
# params, all splatted from CLIMATE_STORE. Only message/log/benchmark are
# workflow-local. wf1's old `climate_historical/wf1_raw/` store and its
# ancient(staticmaps.nc) edge are retired — the extent is now a pure function of
# shared.basin + the catalog, so this rule needs no built model, and a region
# change re-extracts via Snakemake's params rerun-trigger.
#
# DO NOT add a workflow-local input or param here: an asymmetric input set
# re-creates the wf1<->wf3 re-extraction oscillation (design P2(b), ext1-02) and
# is forbidden. The catalog input is deliberately PLAIN, not ancient(): it is
# the store's freshness boundary (ext2-01).
rule extract_climate_grid:
    message: rule_banner("1.10", "extract_climate_grid")
    input:
        **CLIMATE_STORE.inputs,
    params:
        **CLIMATE_STORE.params,
    output:
        **CLIMATE_STORE.outputs,
    log:
        f"{LOG_PARTS_DIR}/1.10_extract_climate_grid.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.10_extract_climate_grid.tsv",
    script:
        CLIMATE_STORE.script

# 1.11  plot_results — analyse + plot the wflow run (parallel leaf with 1.12/1.13)
# The climate plots read the shared store's extraction (rule 1.10) at model
# parity — not the inmaps forcing (P3-2a re-source; was ADR 0002). On chirps/
# chirps_global the extraction's orography sidecar is a declared input with a
# real producer edge (ext2-1); producer and consumer resolve that branch from
# the same clim_historical key via CLIMATE_STORE, so they cannot disagree.
_wf1_plot_clim_inputs = {"climate_nc": CLIMATE_STORE.outputs["climate_nc"]}
if clim_source in ("chirps", "chirps_global"):
    _wf1_plot_clim_inputs["oro_nc"] = CLIMATE_STORE.outputs["oro_nc"]

# O-24, basin-average half. The ONE plot_results family that is a pure function
# of config, so it is declared rather than left undeclared.
#
# Two exclusions, both load-bearing — do not "simplify" either away:
#  - "river discharge" never gets a basavg column at all. Rule 1.05 covers it
#    via setup_outlets/setup_gauges and filters it out of the basin-average
#    setup (setup_gauges_and_outputs.py, `extras`).
#  - "precipitation" DOES get a column, and plot_results drops it before
#    plotting (plot_results.py, `drop_vars("precipitation_basavg")`), so the
#    figure is never written.
# The filename is the CSV column name verbatim (func_plot_signature.plot_basavg
# writes f"{dvar}.png"), which is why it carries the config's spelling, spaces
# included.
_WFLOW_OUTVARS_WITHOUT_BASAVG_PLOT = ("river discharge", "precipitation")
_basavg_pngs = [
    f"{basin_dir}/evaluation/plots/{var}_basavg.png"
    for var in wflow_outvars
    if var not in _WFLOW_OUTVARS_WITHOUT_BASAVG_PLOT
]

rule plot_results:
   message: rule_banner("1.11", "plot_results")
   input:
       csv_path = f"{basin_dir}/run_default/output.csv",
       # ADR 0004; transitively ordered after 1.08 via 1.09, declared for the
       # same reason as there.
       model_final = ancient(f"{basin_dir}/.model_final"),
       **_wf1_plot_clim_inputs,
       # Both observation files, when configured: this rule reads the gauge
       # positions AND the observed series, so either changing must re-evaluate.
       **_locations_input,
       **_observations_input,
       location_registry = f"{spatial_dir}/location_registry.csv",
       script = "blueearth_cst/model/plot_results.py"
   # R07 B10 + O-24. The artifacts move into the engine subtree, split by KIND
   # (P1): figures under evaluation/plots/, the metrics table one level up in
   # evaluation/, because plots/ holds figures only.
   #
   # O-24, restated 2026-08-01 after checking what is actually derivable.
   #
   # DECLARED: the config-invariant subset below, plus `_basavg_pngs` — one PNG
   # per basin-average entry in wflow_outvars, a pure function of config.
   #
   # STILL UNDECLARED, and NOT for want of effort: hydro_{station}.png,
   # clim_{station}_{month,year}.png and signatures_{station}.png. R7-5 assumed
   # these could be derived at parse time "from wflow_outvars /
   # output_locations". They cannot. Their count is the number of model OUTLETS
   # and SUBCATCHMENTS, which is a product of the model build (rule 1.03, read
   # back through Q_outlets / the subcatchment map) — unknown until rule 1.03
   # has run, and output_locations contributes only the extra gauge stations on
   # top. signatures_* is narrower still: it also requires observations AND a
   # run longer than a year (plot_results.py `do_signatures`), so it is
   # data-conditional, not merely config-conditional.
   #
   # Closing those needs a checkpoint or a directory() output, i.e. a real
   # rule-shape change, not the enumeration R7-5 imagined. `--delete-all-output`
   # completeness therefore still holds only for configs without extra gauges.
   #
   # KNOWN CONSEQUENCE of declaring the two clim_wflow_1_* figures: they are
   # written only when the store's extraction is present AND covers >= 365
   # days (plot_results.py's climate branch). A config with a sub-year
   # historical_window now fails here with MissingOutputException instead of
   # logging a skip. Every shipped config spans years, so no shipped config is
   # affected; recorded because it is a NEW failure mode, not just a
   # declaration.
   output:
       output_png = f"{basin_dir}/evaluation/plots/hydro_wflow_1.png",
       clim_month_png = f"{basin_dir}/evaluation/plots/clim_wflow_1_month.png",
       clim_year_png = f"{basin_dir}/evaluation/plots/clim_wflow_1_year.png",
       metrics_csv = f"{basin_dir}/evaluation/performance_metrics.csv",
       basavg_pngs = _basavg_pngs,
   params:
       project_dir = f"{project_dir}",
       # The model root is OWNED BY THE RULE, not rebuilt inside the script.
       # plot_results.py used to derive `{project_dir}/hydrology_model` itself,
       # which made the model's location a fact spelled in two places; this move
       # is what forced the question, and passing it is the answer.
       model_dir = basin_dir,
       data_sources = DATA_SOURCES,
       clim_source = clim_source,
   log:
       f"{LOG_PARTS_DIR}/1.11_plot_results.log",
   benchmark:
       f"{project_dir}/benchmarks/_parts/1.11_plot_results.tsv",
   script: "blueearth_cst/model/plot_results.py"

# 1.12  plot_map — plot basin, rivers, gauges and DEM on a map (parallel leaf)
rule plot_map:
    message: rule_banner("1.12", "plot_map")
    input:
        gauges_path = f"{basin_dir}/staticgeoms/outlets.geojson",
        # RACE FIX, 2026-08-04. plot_map reads staticmaps.nc straight off disk
        # (plot_map.load_basin_layers -- it stopped asking hydromt at R7) but
        # declared only the gauges layer, so nothing ordered it after rule 1.04
        # add_reservoirs_lakes_glaciers. Under `-c 1` they never overlap and the
        # ordering held by accident; a cold `-c 3` run schedules them together
        # and 1.12 dies with NO Python traceback. That silence is the tell:
        # `HDF5_USE_FILE_LOCKING = "FALSE"` in the pixi env means a concurrent
        # read while another process writes is unprotected, so it aborts below
        # Python. Reproduced three times at `-c 3`; 18/18 at `-c 1`.
        #
        # The ordering anchor is the SENTINEL, not staticmaps.nc. Declaring
        # staticmaps.nc alone does not fix it -- rule 1.04 writes that file as
        # an UNDECLARED SIDE EFFECT (its only declared output is
        # reservoirs_lakes_glaciers.txt), so Snakemake attributes staticmaps.nc
        # to 1.03 build_wflow_model and orders 1.12 after 1.03, which is exactly
        # where it already was. `.outputs_configured` is rule 1.05's completion
        # marker and 1.05 runs after 1.04, so it is the earliest edge that means
        # "every writer of staticmaps.nc is done" -- the same use rule 1.07
        # already makes of it.
        #
        # Both are declared: the sentinel for ORDERING, staticmaps.nc because
        # this rule genuinely reads it and a declaration that says so is what
        # stops the next reader from re-deriving all of the above. `ancient()`
        # on both supplies the edge without a timestamp rerun-trigger, so no
        # rebuild cascade appears.
        model_final = ancient(f"{basin_dir}/.model_final"),
        basin_nc = ancient(f"{basin_dir}/staticmaps.nc"),
        **_locations_input,
    # R07 B10: basin_area depicts the MODEL, not its evaluation (P1), so it
    # sits at the model root's plots/. Two formats, one render: the PDF is the
    # publication deliverable (vector line art, embedded TrueType), the PNG the
    # preview every other consumer reads (baseline fingerprint, quick review).
    output:
        output_map_pdf = f"{basin_dir}/plots/basin_area.pdf",
        output_map_png = f"{basin_dir}/plots/basin_area.png",
    params:
        project_dir = f"{project_dir}",
        # Rule-owned model root; see rule 1.11's note.
        model_dir = basin_dir,
    log:
        f"{LOG_PARTS_DIR}/1.12_plot_map.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.12_plot_map.tsv",
    script: "blueearth_cst/shared/plot_map.py"

# 1.13  plot_forcing — the canonical climate set for the wflow forcing
# (parallel leaf). Same figures as rule 1.15 draws for the source grid, so the
# two directories answer "what did the downscaling change?" side by side.
rule plot_forcing:
    message: rule_banner("1.13", "plot_forcing")
    input:
        forcing_path = f"{basin_dir}/forcing/inmaps_historical.nc",
        # ADR 0004; see rule 1.09.
        model_final = ancient(f"{basin_dir}/.model_final"),
        **_locations_input,
    # R07 B10 + O-24: the forcing/model-input QA figures sit beside the forcing
    # they describe, and ALL of them are declared — variable x kind is a fixed
    # cross-product, so the list comes from climate_figures.figure_names()
    # rather than being restated here.
    output:
        _forcing_climate_pngs,
    params:
        project_dir = f"{project_dir}",
        # Rule-owned model root; see rule 1.11's note.
        model_dir = basin_dir,
    log:
        f"{LOG_PARTS_DIR}/1.13_plot_forcing.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.13_plot_forcing.tsv",
    script: "blueearth_cst/model/plot_map_forcing.py"

# --- benchmark gather ---------------------------------------------------------
# Per-rule benchmarks land under benchmarks/_parts/. This runs once, after the
# terminal outputs (so all WF1 rules ran), and merges the WF1 parts into one
# benchmarks/wf1_benchmarks.tsv (rule column + TOTAL row), fresh each run.
rule gather_benchmarks:
    message: rule_banner("1.14", "gather_benchmarks")
    input:
        WF1_TERMINALS,
    output:
        f"{project_dir}/benchmarks/wf1_benchmarks.md",
    params:
        parts_dir = f"{project_dir}/benchmarks/_parts",
        workflow_num = 1,
    script: "blueearth_cst/shared/merge_benchmarks.py"

# 1.15  plot_climate_source — source-grid climate figures from the shared store
# (R07 B4 / P4). Declared HERE ONLY: unlike rule 1.10 this is a single
# declaration, so none of B1's two-DAG symmetry machinery applies.
#
# The whole subgraph of these figures is rule 1.10 (whose sole input is the
# tracked data catalog) plus this rule, so they build with NEITHER
# models/hydrology/wflow/ NOR config/templates/wflow_build_model.yml on disk — the P4
# assertion, pinned by tests/test_plot_climate_source.py.
#
# The data catalog rides in `params`, not `input`: the era5 branch resolves
# `era5_orography` through it, but the store's freshness boundary is rule 1.10's
# catalog edge (ext2-01) and duplicating it here would re-plot on every catalog
# touch without the extraction having changed.
_source_plot_inputs = {"climate_nc": CLIMATE_STORE.outputs["climate_nc"]}
if clim_source in ("chirps", "chirps_global"):
    # Same branch split as rule 1.11: on chirps the store carries an orography
    # sidecar and it is a declared input; on era5 there is none and the
    # orography comes from the catalog instead.
    _source_plot_inputs["oro_nc"] = CLIMATE_STORE.outputs["oro_nc"]

rule plot_climate_source:
    message: rule_banner("1.15", "plot_climate_source")
    input:
        **_source_plot_inputs,
    output:
        [f"{store_dir}/plots/{name}" for name in figure_names("source")],
    params:
        plot_dir = f"{store_dir}/plots",
        data_sources = DATA_SOURCES,
        clim_source = clim_source,
    log:
        f"{LOG_PARTS_DIR}/1.15_plot_climate_source.log",
    benchmark:
        f"{project_dir}/benchmarks/_parts/1.15_plot_climate_source.tsv",
    script: "blueearth_cst/climate_analysis/plot_climate_source.py"

# 1.16  gather_logs — merge every WF1 log part into ONE workflow log.
#
# Same rule as WF2's 2.07 and WF3's 3.13, against the same script; only the label
# list, the parts dir and the output name differ. `input:` is WF1_TERMINALS, the
# same set gather_benchmarks takes, which is what schedules it LAST: every
# logging rule is upstream of it. The parts stay in `params:` — they are
# `log:` files, and Snakemake does not track those in the DAG, so naming them as
# `input:` would demand them as buildable targets.
#
# The merge DELETES the parts it consumed and prunes the emptied dirs, so a clean
# full run leaves no logs/_parts/ at all. After a PARTIAL re-run only the re-run
# rules have parts, so the rewritten log marks the rest "no part from this run" —
# the same trade `merge_benchmarks` makes (dev/followups.md R7-9).
rule gather_logs:
    message: rule_banner("1.16", "gather_logs")
    input:
        WF1_TERMINALS,
    output:
        f"{project_dir}/logs/{WORKFLOW_LOG_NAME}",
    params:
        rules = LOG_RULES,
        parts_dir = LOG_PARTS_DIR,
    script: "blueearth_cst/shared/merge_logs.py"
